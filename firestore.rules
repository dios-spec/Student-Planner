rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isTeacher() {
      return isSignedIn() && request.auth.token.get('role', 'student') == 'teacher';
    }
    function isStudent() {
      return isSignedIn() && !isTeacher();
    }
    function strLen(field, max) {
      return field is string && field.size() <= max;
    }
    function validClass(c) {
      return c in ['7A', '7B', '7C'];
    }
    function validProfileRole(data) {
      return data.get('role', 'student') in ['student', 'teacher'];
    }
    function isStudentProfileCreate(data) {
      return data.get('role', 'student') == 'student'
        && !data.keys().hasAny(['teacherVerifiedAt', 'teacherVerifiedBy', 'teacherRoleVersion', 'roleUpdatedAt']);
    }
    function serverRoleFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'teacherVerifiedAt', 'teacherVerifiedBy', 'teacherRoleVersion', 'roleUpdatedAt']);
    }
    function validMediaUrl(value) {
      return value == ''
        || value.matches('https://res\\.cloudinary\\.com/.*')
        || value.matches('https://firebasestorage\\.googleapis\\.com/.*');
    }
    function validNotificationRoute(route) {
      return route == '/' || route.matches('/[A-Za-z0-9].*');
    }
    function targetIsStudent(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.get('role', 'student') != 'teacher';
    }
    function publicPushFieldsUnchangedOrRemoved() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['fcmToken', 'fcmTokens', 'pushUpdatedAt'])
        || !request.resource.data.keys().hasAny(['fcmToken', 'fcmTokens', 'pushUpdatedAt']);
    }

    // ---- Users / profiles ----
    // Anyone signed in (anonymously) can read any profile (needed to show names/avatars
    // across planner items, chat, etc). A user can only ever write their own document,
    // and only the editable fields — createdAt can't be forged after creation.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid)
        && strLen(request.resource.data.displayName, 24)
        && strLen(request.resource.data.get('bio', ''), 80)
        && !request.resource.data.keys().hasAny(['fcmToken', 'fcmTokens', 'pushUpdatedAt'])
        // A new client profile is always a student. Only the Admin SDK
        // verification endpoint may add the teacher role and timestamp.
        && isStudentProfileCreate(request.resource.data);
      allow update: if isOwner(uid)
        && strLen(request.resource.data.displayName, 24)
        && strLen(request.resource.data.get('bio', ''), 80)
        && validProfileRole(request.resource.data)
        && serverRoleFieldsUnchanged()
        && publicPushFieldsUnchangedOrRemoved()
        // createdAt must never change after creation
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // Private per-user push tokens. Public profile readers never see these.
    match /pushDevices/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['fcmToken', 'fcmTokens', 'pushUpdatedAt'])
        && strLen(request.resource.data.get('fcmToken', ''), 4096)
        && request.resource.data.get('fcmTokens', []) is list
        && request.resource.data.get('fcmTokens', []).size() <= 20
        && request.resource.data.pushUpdatedAt == request.time;
      allow delete: if isOwner(uid);
    }

    // Server-only rate-limit state for teacher verification. Admin SDK writes
    // bypass Firestore Rules; no app client can inspect, reset or forge it.
    match /teacherVerificationAttempts/{attemptId} {
      allow read, write: if false;
    }

    // ---- Planner items: shared, editable by any signed-in student ----
    match /plannerItems/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && validClass(request.resource.data.classId)
        && strLen(request.resource.data.title, 120)
        && strLen(request.resource.data.get('description', ''), 400)
        && strLen(request.resource.data.subject, 40)
        && request.resource.data.get('attachments', []) is list
        && request.resource.data.get('attachments', []).size() <= 4
        && request.resource.data.category in
             ['bring', 'reading', 'writing', 'test', 'project', 'important'];
      // Edits and soft-deletes are allowed from any student (shared source of truth),
      // but the original author/timestamps can't be rewritten, and updatedBy must be truthful.
      allow update: if isSignedIn()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && validClass(request.resource.data.classId)
        && strLen(request.resource.data.title, 120)
        && strLen(request.resource.data.get('description', ''), 400)
        && strLen(request.resource.data.subject, 40)
        && request.resource.data.category in
             ['bring', 'reading', 'writing', 'test', 'project', 'important']
        && request.resource.data.get('attachments', []) is list
        && request.resource.data.get('attachments', []).size() <= 4;
      allow delete: if false; // use soft-delete (the `deleted` flag) instead
    }

    // ---- Personal completion state: only the owning user can read/write their own ----
    match /completionStatus/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && docId == request.resource.data.userId + '_' + request.resource.data.itemId;
      allow delete: if false;
    }

    // ---- Personal notes: private, never shared ----
    match /personalNotes/{noteId} {
      allow read, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && strLen(request.resource.data.text, 300);
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && strLen(request.resource.data.text, 300);
    }

    // ---- Announcements: any student can post, nobody edits after posting ----
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && validClass(request.resource.data.classId)
        && strLen(request.resource.data.title, 120)
        && strLen(request.resource.data.get('body', ''), 400);
      allow update: if false;
      // Only the author may delete their own announcement.
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // ---- Posts: image feed. Anyone signed in can create/read; author-only delete. ----
    match /posts/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.imageUrl.matches('https://res\\.cloudinary\\.com/.*')
        && strLen(request.resource.data.get('caption', ''), 300);
      // Any signed-in user may like (touch only the `likes` array); nothing else is editable.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // ---- Stories: 24h image stories. Author-only delete; anyone may mark "seen". ----
    match /stories/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.imageUrl.matches('https://res\\.cloudinary\\.com/.*');
      // Story content is immutable after posting; only seen/like state may change.
      allow update: if isSignedIn()
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy', 'likes']);
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // ---- Student Class Chat ----
    // Verified teachers are deliberately excluded: their /chat route uses
    // teacherMessages instead, and the custom claim is enforced here too.
    match /messages/{id} {
      allow read: if isStudent();
      allow create: if isStudent()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && strLen(request.resource.data.get('text', ''), 500)
        && validMediaUrl(request.resource.data.get('imageUrl', ''))
        && validMediaUrl(request.resource.data.get('audioUrl', ''));
      allow update: if isStudent()
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (resource.data.senderId == request.auth.uid
            && strLen(request.resource.data.get('text', ''), 500)
            && validMediaUrl(request.resource.data.get('imageUrl', ''))
            && validMediaUrl(request.resource.data.get('audioUrl', ''))
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['deleted', 'text', 'imageUrl', 'audioUrl', 'reactions', 'edited']))
          ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll'])
        );
      allow delete: if false;
    }

    // ---- Teachers Chat ----
    // Both UI routing and Firestore enforce the verified custom claim.
    match /teacherMessages/{id} {
      allow read: if isTeacher();
      allow create: if isTeacher()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && strLen(request.resource.data.get('text', ''), 500)
        && validMediaUrl(request.resource.data.get('imageUrl', ''))
        && validMediaUrl(request.resource.data.get('audioUrl', ''));
      allow update: if isTeacher()
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (resource.data.senderId == request.auth.uid
            && strLen(request.resource.data.get('text', ''), 500)
            && validMediaUrl(request.resource.data.get('imageUrl', ''))
            && validMediaUrl(request.resource.data.get('audioUrl', ''))
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['deleted', 'text', 'imageUrl', 'audioUrl', 'reactions', 'edited']))
          ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll'])
        );
      allow delete: if false;
    }

    // ---- Study Help materials: class-scoped image library. Uploader-only delete. ----
    match /studyMaterials/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uploaderId == request.auth.uid
        && validClass(request.resource.data.classId)
        && request.resource.data.imageUrl.matches('https://res\\.cloudinary\\.com/.*')
        && strLen(request.resource.data.title, 120)
        && strLen(request.resource.data.chapter, 60)
        && strLen(request.resource.data.subject, 40)
        && strLen(request.resource.data.get('description', ''), 240)
        && request.resource.data.get('kind', 'notes') in
             ['notes', 'summary', 'formula-sheet', 'mind-map', 'question-paper', 'diagram', 'other'];
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uploaderId == request.auth.uid;
    }

    // ---- Comments on posts: anyone signed in can add/read; author-only delete. ----
    match /comments/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && strLen(request.resource.data.text, 300)
        && request.resource.data.postId is string;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // ---- Conversations (DMs + groups): only members can read/write ----
    match /conversations/{convId} {
      function isMember() {
        return isSignedIn() && request.auth.uid in resource.data.memberIds;
      }
      function isGroupAdmin() {
        return isMember()
          && resource.data.type == 'group'
          && resource.data.get('adminIds', []) is list
          && request.auth.uid in resource.data.get('adminIds', []);
      }
      function memberReadUpdateOnly() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['unread', 'lastReadAt'])
          && request.resource.data.get('unread', {}).diff(resource.data.get('unread', {}))
                 .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get('lastReadAt', {}).diff(resource.data.get('lastReadAt', {}))
                 .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get('unread', {}).get(request.auth.uid, 0) == 0;
      }
      function memberMessagePreviewOnly() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastText', 'lastSenderId', 'lastAt', 'unread'])
          && request.resource.data.lastSenderId == request.auth.uid
          && request.resource.data.lastAt == request.time
          && strLen(request.resource.data.get('lastText', ''), 240);
      }
      function adminGroupUpdate() {
        return isGroupAdmin()
          && request.auth.uid in request.resource.data.memberIds
          && request.auth.uid in request.resource.data.get('adminIds', [])
          && request.resource.data.memberIds is list
          && request.resource.data.memberIds.size() >= 2
          && request.resource.data.memberIds.size() <= 100
          && request.resource.data.get('adminIds', []) is list
          && request.resource.data.get('adminIds', []).size() >= 1
          && request.resource.data.get('adminIds', []).size() <= request.resource.data.memberIds.size()
          && request.resource.data.memberIds.toSet().hasAll(request.resource.data.get('adminIds', []))
          && request.resource.data.get('members', {}) is map
          && request.resource.data.get('unread', {}) is map
          && strLen(request.resource.data.get('name', ''), 80)
          && strLen(request.resource.data.get('description', ''), 300)
          && validMediaUrl(request.resource.data.get('photoUrl', ''))
          && (!('classId' in request.resource.data) || validClass(request.resource.data.classId))
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'description', 'photoUrl', 'classId', 'memberIds', 'adminIds', 'members', 'unread']);
      }
      function nonAdminSelfLeave() {
        return resource.data.type == 'group'
          && !(request.auth.uid in resource.data.get('adminIds', []))
          && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
          && request.resource.data.get('adminIds', []) == resource.data.get('adminIds', [])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']);
      }
      function adminSelfLeave() {
        return resource.data.type == 'group'
          && request.auth.uid in resource.data.get('adminIds', [])
          && resource.data.get('adminIds', []).size() > 1
          && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
          && request.resource.data.get('adminIds', []) == resource.data.get('adminIds', []).removeAll([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'adminIds']);
      }

      allow read: if isMember();

      allow create: if isSignedIn()
        && request.resource.data.type in ['dm', 'group']
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() >= 2
        && request.resource.data.memberIds.size() <= 100
        && request.resource.data.members is map
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.type == 'dm'
            && request.resource.data.memberIds.size() == 2)
          ||
          (request.resource.data.type == 'group'
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.get('adminIds', []) is list
            && request.auth.uid in request.resource.data.get('adminIds', [])
            && request.resource.data.get('adminIds', []).size() >= 1
            && request.resource.data.get('adminIds', []).size() <= request.resource.data.memberIds.size()
            && request.resource.data.memberIds.toSet().hasAll(request.resource.data.get('adminIds', []))
            && strLen(request.resource.data.get('name', ''), 80)
            && strLen(request.resource.data.get('description', ''), 300)
            && validMediaUrl(request.resource.data.get('photoUrl', ''))
            && (!('classId' in request.resource.data) || validClass(request.resource.data.classId)))
        );

      allow update: if isMember()
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          memberReadUpdateOnly()
          || memberMessagePreviewOnly()
          || adminGroupUpdate()
          || nonAdminSelfLeave()
          || adminSelfLeave()
        );

      allow delete: if false;

      match /messages/{msgId} {
        function convData() {
          return get(/databases/$(database)/documents/conversations/$(convId)).data;
        }
        function convMember() {
          return isSignedIn() && request.auth.uid in convData().memberIds;
        }

        allow read: if convMember();
        allow create: if convMember()
          && request.resource.data.conversationId == convId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.kind in
               ['text', 'image', 'voice', 'sharedPost', 'sharedReel', 'sharedStory', 'poll']
          && strLen(request.resource.data.get('text', ''), 2000)
          && validMediaUrl(request.resource.data.get('imageUrl', ''))
          && validMediaUrl(request.resource.data.get('audioUrl', ''));
        allow update: if convMember()
          && request.resource.data.conversationId == resource.data.conversationId
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            (resource.data.senderId == request.auth.uid
              && strLen(request.resource.data.get('text', ''), 2000)
              && validMediaUrl(request.resource.data.get('imageUrl', ''))
              && validMediaUrl(request.resource.data.get('audioUrl', ''))
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['deleted', 'text', 'imageUrl', 'audioUrl', 'edited']))
            ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll'])
          );
        allow delete: if false;
      }
    }

    // ---- Blocks: a user manages only their own block entries ----
    match /blocks/{id} {
      allow read: if isSignedIn()
        && (resource.data.blockerId == request.auth.uid || resource.data.blockedId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.blockerId == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.blockedId;
      allow delete: if isSignedIn() && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    // ---- Reels: short videos. Anyone signed in creates/reads; author-only delete. ----
    match /reels/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.videoUrl.matches('https://res\\.cloudinary\\.com/.*')
        && strLen(request.resource.data.get('caption', ''), 300);
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // ---- Notifications: recipient-owned inbox; creation is schema-limited ----
    match /notifications/{id} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
             'userId', 'type', 'title', 'body', 'icon', 'route', 'data',
             'fromUid', 'read', 'createdAt'
           ])
        && request.resource.data.userId is string
        && request.resource.data.userId != request.auth.uid
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.type in [
             'dm', 'groupMessage', 'reply', 'comment', 'groupInvite',
             'adminPromote', 'addedToGroup', 'homework', 'exam',
             'announcement', 'incomingCall', 'missedCall', 'postLike',
             'classMessage', 'classReaction', 'studyHelp', 'storyNew',
             'reelLike', 'storyLike'
           ]
        && strLen(request.resource.data.title, 120)
        && strLen(request.resource.data.get('body', ''), 500)
        && validMediaUrl(request.resource.data.get('icon', ''))
        && strLen(request.resource.data.get('route', '/'), 300)
        && validNotificationRoute(request.resource.data.get('route', '/'))
        && request.resource.data.get('data', {}) is map
        && request.resource.data.get('data', {}).size() <= 20
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
    }

    // ---- Calls: members may update call state, but not rewrite call identity ----
    match /calls/{callId} {
      function conversationData() {
        return get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data;
      }
      function callMember() {
        return isSignedIn() && request.auth.uid in resource.data.memberIds;
      }

      allow read: if callMember();
      allow create: if isSignedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'ringing'
        && request.resource.data.type in ['dm', 'group']
        && request.resource.data.conversationId is string
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() >= 2
        && request.resource.data.memberIds.size() <= 100
        && request.resource.data.participants is map
        && request.resource.data.memberIds == conversationData().memberIds
        && request.resource.data.type == conversationData().type;
      allow update: if callMember()
        && request.resource.data.conversationId == resource.data.conversationId
        && request.resource.data.type == resource.data.type
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in
             ['ringing', 'connecting', 'connected', 'declined', 'ended', 'missed', 'unavailable']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'participants', 'endedAt'])
        && request.resource.data.participants.diff(resource.data.participants)
             .affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if false;

      // ICE candidates / SDP exchanged between peers, scoped to the call.
      match /signals/{sigId} {
        function callData() {
          return get(/databases/$(database)/documents/calls/$(callId)).data;
        }
        function isCallMember() {
          return isSignedIn() && request.auth.uid in callData().memberIds;
        }

        allow read: if isCallMember();
        allow create, update: if isCallMember()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to is string
          && request.resource.data.to in callData().memberIds
          && sigId == request.auth.uid + '__' + request.resource.data.to
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }

    // ---- App-wide small metadata docs (e.g. class chat pinned messages, typing indicators) ----
    match /appMeta/{id} {
      allow read: if isStudent();
      allow write: if isStudent()
        && (!('pinned' in request.resource.data) ||
            (request.resource.data.pinned is list && request.resource.data.pinned.size() <= 20))
        && (!('typing' in request.resource.data) || request.resource.data.typing is map);
    }

    // ---- Timetable: one shared doc per class, editable by any signed-in student ----
    match /timetable/{classId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && validClass(classId);
    }

    // ---- Saved items: fully private bookmarks, owner-only ----
    match /saved/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ---- Reminders: fully private to the owner; only the server (Admin SDK) marks them sent ----
    match /reminders/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.sent == false
        && strLen(request.resource.data.get('itemTitle', ''), 200);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }


    // ---- Merit / Demerit: live school points managed by verified teachers ----
    // Signed-in users may read totals/history for profile display. Only a verified
    // teacher claim can change records from the app. Firebase Console/Admin SDK
    // can still correct or remove mistakes normally.
    match /meritRecords/{recordId} {
      allow read: if isSignedIn();

      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.studentId is string
        && targetIsStudent(request.resource.data.studentId)
        && validClass(request.resource.data.classId)
        && request.resource.data.kind in ['merit', 'demerit']
        && request.resource.data.points is int
        && request.resource.data.points >= 1
        && request.resource.data.points <= 10
        && strLen(request.resource.data.reason, 160)
        && request.resource.data.createdAt == request.time;

      // Practical correction path for verified teachers. Student clients still
      // cannot edit their own points. Console/Admin can always correct mistakes.
      allow update: if isTeacher()
        && request.resource.data.studentId == resource.data.studentId
        && targetIsStudent(request.resource.data.studentId)
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.createdAt == resource.data.createdAt
        && validClass(request.resource.data.classId)
        && request.resource.data.kind in ['merit', 'demerit']
        && request.resource.data.points is int
        && request.resource.data.points >= 1
        && request.resource.data.points <= 10
        && strLen(request.resource.data.reason, 160);

      allow delete: if isTeacher();
    }

    // ---- Reports: write-only from students, readable only via the console/admin ----
    match /reports/{id} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}