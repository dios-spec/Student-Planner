# Copy this file to .env, then fill in the values from your Firebase project:
# Firebase Console -> Project Settings -> General -> "Your apps" -> Web app config
#
# These values are safe to ship in a frontend bundle — they identify your Firebase
# project, they are not secrets. Real protection comes from firestore.rules and
# storage.rules (already included in this project) plus Firebase App Check if you add it.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
