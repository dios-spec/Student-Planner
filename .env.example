# Copy this file to .env, then fill in the values below.

# --- Firebase (Auth + Firestore) ---
# Firebase Console -> Project Settings -> General -> "Your apps" -> Web app config
# Safe to ship in a frontend bundle — not secrets. Real protection is firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates
VITE_FIREBASE_VAPID_KEY=

# --- Cloudinary (image uploads — free tier, no credit card needed) ---
# cloudinary.com -> Dashboard -> "Cloud name"
VITE_CLOUDINARY_CLOUD_NAME=
# cloudinary.com -> Settings -> Upload -> Upload presets -> Add preset -> Signing Mode: Unsigned
VITE_CLOUDINARY_UPLOAD_PRESET=

# --- TURN server for voice calls (optional but recommended) ---
# Free tier: metered.ca -> sign up -> your app -> "TURN Server" credentials.
# Without these, calls use STUN only and may fail across some mobile networks.
# VITE_TURN_URL can be a comma-separated list of turn: URLs from Metered.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
