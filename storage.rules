rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function underSize(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // Avatars: only the owning user may upload to their own folder.
    match /avatars/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid && isImage() && underSize(3);
    }

    // Chat images: any signed-in student can read; only the uploader can write to their folder.
    match /chatImages/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid && isImage() && underSize(8);
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
